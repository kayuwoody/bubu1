# Supabase — get from Project Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Fiuu — get from Fiuu merchant portal
FIUU_MERCHANT_ID=your_merchant_id
FIUU_VERIFY_KEY=your_verify_key
FIUU_SECRET_KEY=your_secret_key
# Sandbox: https://sandbox-payment.fiuu.com  Production: https://pay.fiuu.com
FIUU_BASE_URL=https://sandbox-payment.fiuu.com

# Base URL — used to build returnurl / callbackurl for Fiuu
# On Vercel this is set automatically as VERCEL_URL (no https://)
# Set this explicitly for local dev or non-Vercel deployments
NEXT_PUBLIC_BASE_URL=https://your-site.vercel.app

# Web push notifications — generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=            # same value as NEXT_PUBLIC_VAPID_PUBLIC_KEY
NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # the public key, exposed to the browser
VAPID_PRIVATE_KEY=           # keep secret, server only
VAPID_SUBJECT=mailto:hello@coffee-oasis.com
# Shared secret for the Supabase → /api/push/notify-ready webhook auth header
PUSH_WEBHOOK_SECRET=
# Passcode the merchant enters at /staff to enrol a phone for new-order alerts
STAFF_PASSCODE=
